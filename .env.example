# Kopieren nach .env.local und Werte aus dem Supabase-Projekt (Entwicklung) eintragen.
# Produktion: Werte von lagerblick-prod nur in Vercel (Umgebung Production) eintragen, siehe docs/betrieb.md.
# Nur den öffentlichen Publishable Key verwenden, niemals den Secret- oder service_role-Key.
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
